# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
# Móvil u otro PC en la misma red: no uses localhost en el teléfono; abre http://IP_DE_ESTA_PC:3000
# y pon la misma URL aquí y en AUTH_URL (cookies / NextAuth). `pnpm dev` ya escucha en 0.0.0.0.
# NEXT_PUBLIC_APP_URL="http://192.168.0.10:3000"
# AUTH_URL="http://192.168.0.10:3000"

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres@localhost:5432/dates_db"

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-min-32-chars-here"
# Opcional: misma URL pública que uses en el navegador (obligatorio si cambias de localhost a IP/dominio).
# AUTH_URL="https://tu-dominio.com"
#
# Heroku (misma URL en el navegador, sin / al final):
# heroku config:set AUTH_URL="https://TU_APP.herokuapp.com"
# heroku config:set NEXT_PUBLIC_APP_URL="https://TU_APP.herokuapp.com"
# heroku config:set AUTH_TRUST_HOST=true
# Tras cambiar variables: heroku restart
# Optional: Add providers as needed
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ─── WhatsApp (única cuenta para toda la app) ─────────────────────────────────
# Opcional: fuerza proveedor. Si no está, se usa Twilio si están las 3 variables, si no Meta si están las 2.
# WHATSAPP_PROVIDER="twilio"
# WHATSAPP_PROVIDER="meta"
#
# Twilio — TWILIO_ACCOUNT_SID (también se acepta TWILIO_ACCOUUNT_SID por typo)
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your-auth-token"
# TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
# Obligatorio para notificaciones (confirmación, recordatorio, cancelación): plantillas Twilio Content aprobadas.
# Mismo orden de variables en las tres: {{1}} nombre cliente, {{2}} fecha/hora/servicio, {{3}} profesional o "—" en cancelación
# TWILIO_CONTENT_SID_CONFIRMATION="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_REMINDER="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_CONTENT_SID_CANCELLATION="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
#
# Meta Cloud API (mismas variables {{1}}{{2}}{{3}} en plantillas creadas en WhatsApp Manager)
# META_WHATSAPP_TOKEN="EAAxxxxxxx"
# META_PHONE_NUMBER_ID="10000000000000"
# META_WHATSAPP_TEMPLATE_CONFIRMATION="nombre_plantilla_confirmacion"
# META_WHATSAPP_TEMPLATE_REMINDER="nombre_plantilla_recordatorio"
# META_WHATSAPP_TEMPLATE_CANCELLATION="nombre_plantilla_cancelacion"
# META_WHATSAPP_TEMPLATE_LANGUAGE="es_AR"
# META_VERIFY_TOKEN="your-webhook-verify-token"  # Solo para webhook de Meta
#
# Bot WhatsApp (Twilio inbound) — POST /api/webhooks/twilio/whatsapp
# WHATSAPP_BOT_ENABLED="true"   # "false" desactiva respuestas del bot
# WHATSAPP_BOT_BUSINESS_ID=""   # Si usás solo .env Twilio (sin número en Business), forzá el negocio (cuid)
# TWILIO_WEBHOOK_BASE_URL="https://tu-dominio.com"  # URL base pública (sin path); firma X-Twilio-Signature
# TWILIO_SKIP_SIGNATURE_VALIDATION="true"  # Solo pruebas locales (nunca en producción)

# ─── Reminder window ──────────────────────────────────────────────────────────
# Horas antes del turno para enviar recordatorio
REMINDER_HOURS_BEFORE="24"
